{
  "$schema": "https://json-schema.org/draft/07/schema",
  "name": "NetworkMaintenance-Pro v3.0",
  "version": "3.0.0",
  "build": "20260910",
  "enterprise": {
    "architecture": "Microservices-Orchestration",
    "compliance": ["ITIL-v4", "ISO-27001", "NIST-CSF", "COBIT-2019"],
    "security_framework": "Zero-Trust",
    "data_layer": "SQLite-Encrypted",
    "api_layer": "REST-Gateway",
    "monitoring": "Prometheus-Metrics",
    "logging": "ELK-Stack-Compatible",
    "deployment": "CI-CD-Pipeline"
  },
  "engine": {
    "diagnostic_engine": {
      "name": "DAX-DiagnosticAnalysisEngine",
      "version": "3.0",
      "algorithms": ["Statistical", "Bayesian", "ML-Anomaly", "Root-Cause-Analysis"],
      "confidence_scoring": true,
      "fuzzy_logic": true,
      "adaptive_thresholds": true,
      "baseline_learning": true
    },
    "optimization_engine": {
      "name": "OCE-OptimizationConvergenceEngine",
      "version": "3.0",
      "strategies": ["Gradient-Descent", "Simulated-Annealing", "Genetic-Algorithm"],
      "multi_objective": true,
      "pareto_optimization": true,
      "constraint_satisfaction": true
    },
    "prediction_engine": {
      "name": "PREDICT-PredictiveEngine",
      "version": "3.0",
      "models": ["ARIMA", "Exponential-Smoothing", "LSTM-Proxy"],
      "forecasting_horizon": "7d",
      "confidence_interval": 0.95,
      "retrain_schedule": "weekly"
    },
    "auto_heal_engine": {
      "name": "HEAL-AutoRemediationEngine",
      "version": "3.0",
      "approach": "Decision-Tree-Classifier",
      "safety_modes": ["Conservative", "Balanced", "Aggressive"],
      "rollback_capability": true,
      "change_tracking": true
    },
    "reporting_engine": {
      "name": "RPT-ReportingEngine",
      "version": "3.0",
      "formats": ["HTML5", "PDF", "JSON", "CSV", "Markdown"],
      "charting": ["D3.js", "Chart.js", "Highcharts"],
      "scheduling": "Cron-based"
    },
    "cleaning_engine": {
      "name": "SCE-SafeCleaningEngine",
      "version": "3.0",
      "principle": "Whitelist-Based Safe Cleaning | Zero-Trust | No Re-Download",
      "safety_modes": ["Conservative", "Balanced", "Aggressive"],
      "default_safety": "Balanced",
      "whitelist_only": true,
      "blacklist_enforced": true,
      "dry_run_default": true,
      "rollback_capability": true,
      "transaction_logging": true,
      "categories": {
        "TempSafe": {
          "enabled": true,
          "patterns": ["*.tmp", "dd_*.log", "*.cpuprofile"],
          "min_age_days": 7,
          "cpuprofile_min_hours": 2,
          "requires_lock_check": true,
          "safe_roots": ["%TEMP%", "C:\\Windows\\Temp"]
        },
        "VSCodeDup": {
          "enabled": true,
          "strategy": "KeepLatestOnly",
          "keep_count": 1,
          "families": ["openai.chatgpt-*", "zoocodeorganization.zoo-code-*", "github.vscode-pull-request-github-*", "zeyutang.kilo-code-*"]
        },
        "DiagLogs": {
          "enabled": true,
          "min_age_days": 30,
          "keep_minimum": 7,
          "paths": ["C:\\NetworkMaintenance\\Logs", "%LOCALAPPDATA%\\..\\.local\\share\\opencode\\tool-output"]
        },
        "PowerPlan": {
          "enabled": true,
          "target": "High performance",
          "rollback_guid": "381b4222-f694-41f0-9685-ff5bb260df2e"
        },
        "Startup": {
          "enabled": true,
          "mode": "REPORT_ONLY",
          "auto_disable": false,
          "heavy_hitters": ["Docker Desktop", "GoogleDriveFS", "Figma Agent"]
        }
      },
      "blacklist": {
        "note": "NEVER auto-delete - requires re-download",
        "package_caches": ["npm-cache", ".npm", "Yarn\\Cache", "pnpm-store", ".nuget\\packages", "cargo\\registry", "pip\\cache"],
        "project_artifacts": ["node_modules", ".next", "dist", "build", "__pycache__", ".venv", ".git"],
        "user_data": ["Documents", "Downloads", "Desktop"],
        "browser_caches": ["Chrome\\User Data", "Edge\\User Data", "Firefox\\Profiles"]
      },
      "limits": {
        "Conservative": { "max_deletions": 20, "max_gb": 0.5 },
        "Balanced": { "max_deletions": 100, "max_gb": 2.0 },
        "Aggressive": { "max_deletions": 500, "max_gb": 5.0 }
      }
    }
  },
  "network": {
    "primary_interface": "Wi-Fi",
    "interfaces": ["Wi-Fi", "vEthernet (Default Switch)", "Bluetooth Network Connection"],
    "dns_servers": ["1.1.1.1", "8.8.8.8", "9.9.9.9", "149.112.112.112"],
    "latency_thresholds": {
      "excellent": 50,
      "good": 100,
      "fair": 150,
      "poor": 300,
      "critical": 500,
      "blackout": 1000
    },
    "packet_loss_thresholds": {
      "excellent": 0,
      "good": 0.5,
      "fair": 1,
      "poor": 2,
      "critical": 5
    },
    "jitter_thresholds": {
      "excellent": 10,
      "good": 20,
      "fair": 50,
      "poor": 100,
      "critical": 200
    }
  },
  "security": {
    "authentication": "Bearer-Token",
    "encryption": "AES-256-GCM",
    "certificate_validation": true,
    "audit_logging": true,
    "role_based_access": ["Admin", "Operator", "Viewer", "ReadOnly"],
    "tls_version": "1.3",
    "data_retention_days": 2555
  },
  "scheduling": {
    "health_check_interval": 300,
    "full_diagnostic_interval": 86400,
    "optimization_interval": 86400,
    "report_generation_interval": 604800,
    "baseline_update_interval": 604800
  },
  "database": {
    "engine": "SQLite",
    "path": "C:\\NetworkMaintenance\\Data\\maintenance.db",
    "encryption_key_file": "C:\\NetworkMaintenance\\Config\\encryption.key",
    "wal_mode": true,
    "connection_pooling": true,
    "max_connections": 10,
    "vacuum_schedule": "weekly"
  },
  "api": {
    "enabled": true,
    "port": 8080,
    "host": "127.0.0.1",
    "cors_origins": ["http://localhost:3000", "http://127.0.0.1:3000"],
    "rate_limiting": {
      "requests_per_minute": 60,
      "burst_size": 10
    },
    "endpoints": [
      "/api/v1/status",
      "/api/v1/diagnostics",
      "/api/v1/metrics",
      "/api/v1/health",
      "/api/v1/reports",
      "/api/v1/optimization",
      "/api/v1/logs",
      "/api/v1/config",
      "/api/v1/clean",
      "/api/v1/clean/status",
      "/api/v1/shop/tickets",
      "/api/v1/shop/customers",
      "/api/v1/shop/inventory",
      "/api/v1/shop/invoices",
      "/api/v1/shop/diagnostics",
      "/api/v1/shop/stats",
      "/api/v1/shop/warranty"
    ]
  },
  "cleaning": {
    "health_check_interval": 3600,
    "auto_clean_schedule": "weekly",
    "auto_clean_time": "03:00",
    "default_temp_age_days": 7,
    "default_log_age_days": 30,
    "enable_power_optimization": true,
    "enable_startup_analysis": true
  },
  "repair_shop": {
    "name": "RepairShop-Pro v4.0",
    "version": "4.0.0",
    "build": "20260911",
    "mode": "MAINTENANCE_ONLY",
    "note": "POS/Billing external - integrates with existing sales/accounting system via API",
    "supported_devices": ["Mobile", "Tablet", "Laptop", "Desktop", "Console", "TV", "Audio", "Other", "IoT", "Embedded"],
    "ticket_prefix": "TKT",
    "customer_prefix": "CUST",
    "warranty_default_days": 30,
    "languages": ["ar", "en"],
    "external_integration": {
      "sales_system": { "enabled": true, "type": "External", "api_endpoint": "/api/v1/external/sales", "sync": "webhook" },
      "accounting_system": { "enabled": true, "type": "External", "api_endpoint": "/api/v1/external/accounting" }
    },
    "engines": {
      "repair": { "name": "REPAIR-TicketEngine", "version": "4.0", "states": ["RECEIVED","DIAGNOSED","QUOTED","APPROVED","REPAIRING","QC","READY","DELIVERED","CANCELLED","WARRANTY"] },
      "crm": { "name": "CRM-CustomerEngine", "version": "4.0", "lite": true, "note": "Minimal - for maintenance tracking only" },
      "parts": { "name": "PARTS-InventoryEngine", "version": "4.0", "purpose": "Maintenance spare parts only", "barcode": "EAN13", "qr": true },
      "hdr": { "name": "HDR-HardwareDiagnostics", "version": "4.1", "modes": ["Quick","Full","Deep"], "ai": true, "open_source": ["smartctl","ADB","OpenHardwareMonitor","CrystalDiskInfo","memtest","stress-ng","iperf3","WinMTR"] },
      "batt": { "name": "BATT-BatteryDiagnostics", "version": "4.1", "tools": ["powercfg","WMIC","ADB dumpsys","Battery Historian","BatteryInfoView"], "metrics": ["health","cycles","temp","voltage","design_vs_full"] },
      "storage": { "name": "STORAGE-Diagnostics", "version": "4.1", "tools": ["smartctl","Get-PhysicalDisk","CrystalDiskInfo","wmic","fio"], "metrics": ["SMART","NVMe","eMMC","wear_level","reallocated"] },
      "stress": { "name": "STRESS-HardwareStress", "version": "4.1", "tools": ["Prime95","stress-ng","FurMark","memtest86","OCCT"], "tests": ["CPU","RAM","GPU","Thermal"] },
      "netdiag": { "name": "NETDIAG-Advanced", "version": "4.1", "tools": ["iperf3","mtr","WinMTR","nmap","Wireshark","dnsbench"], "metrics": ["latency","jitter","packet_loss","bandwidth","dns"] }
    },
    "ai": {
      "diagnostics": true,
      "failure_prediction": true,
      "confidence": 0.90,
      "models": ["IsolationForest","XGBoost","LSTM"]
    },
    "open_source": {
      "note": "Leverages best open source projects",
      "projects": ["smartmontools/smartctl","Genymobile/scrcpy","libimobiledevice","OpenHardwareMonitor","CrystalDiskInfo","memtest86+","stress-ng","iperf3","WinMTR","Wireshark","BleachBit","TestDisk","HDDScan"],
      "licenses": ["GPL","MIT","Apache-2.0"]
    }
  }
}
