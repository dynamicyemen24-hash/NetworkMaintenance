{
  "name": "elias-pro",
  "version": "5.0.0",
  "description": "Elias Pro v5.0 — Universal Maintenance Suite — Enhanced Modules | Zero-Trust | AES-256-GCM | TLS 1.3 | Production Monitoring + E2E + Zero-Downtime",
  "private": true,
  "scripts": {
    "test": "playwright test",
    "test:e2e": "playwright test --project=chromium",
    "test:ui": "playwright test --ui",
    "test:report": "playwright show-report",
    "dev": "powershell -ExecutionPolicy Bypass -File .\\API\\Server-Pode.ps1 -Port 8080 -EnableSwagger",
    "api": "powershell -ExecutionPolicy Bypass -File .\\API\\Server-Pode.ps1",
    "health": "powershell -ExecutionPolicy Bypass -File .\\Scripts\\Engines\\ERROR-Engine.ps1 -Action health",
    "deploy:check": "powershell -ExecutionPolicy Bypass -File .\\Scripts\\Engines\\DEPLOY-Engine.ps1 -Action health",
    "deploy:canary": "powershell -ExecutionPolicy Bypass -File .\\Scripts\\Engines\\DEPLOY-Engine.ps1 -Action deploy -Strategy Canary -DryRun",
    "deploy:bluegreen": "powershell -ExecutionPolicy Bypass -File .\\Scripts\\Engines\\DEPLOY-Engine.ps1 -Action deploy -Strategy BlueGreen -NewVersion 5.0.0 -DryRun",
    "security": "powershell -ExecutionPolicy Bypass -File .\\Modules\\SecurityEnhancement.ps1 -Action full",
    "reliability": "powershell -ExecutionPolicy Bypass -File .\\Modules\\ReliabilityModule.ps1 -Action full",
    "effectiveness": "powershell -ExecutionPolicy Bypass -File .\\Modules\\EffectivenessModule.ps1 -Action full",
    "standardization": "powershell -ExecutionPolicy Bypass -File .\\Modules\\StandardizationModule.ps1 -Action full",
    "publish": "powershell -ExecutionPolicy Bypass -File .\\publish.ps1 -Version 5.0.0",
    "watchdog": "powershell -ExecutionPolicy Bypass -File .\\Scripts\\Network-Reliability-Watchdog.ps1",
    "reports": "powershell -ExecutionPolicy Bypass -File .\\Scripts\\Generate-BusinessReports.ps1 -Days 30",
    "reports:rpt": "powershell -ExecutionPolicy Bypass -File .\\Scripts\\Engines\\RPT-Engine.ps1",
    "expert": "powershell -ExecutionPolicy Bypass -File .\\Scripts\\Expert-Advisor.ps1 -Mode Triage",
    "expert:tickets": "powershell -ExecutionPolicy Bypass -File .\\Scripts\\Expert-Advisor.ps1 -Mode Tickets",
    "expert:guide": "powershell -ExecutionPolicy Bypass -File .\\Scripts\\Expert-Advisor.ps1 -Mode Guide"
  },
  "devDependencies": {
    "@playwright/test": "^1.44.0",
    "playwright": "^1.44.0"
  },
  "engines": {
    "node": ">=18"
  },
  "author": "FixMaster Technology — Elias Pro",
  "license": "Proprietary"
}
